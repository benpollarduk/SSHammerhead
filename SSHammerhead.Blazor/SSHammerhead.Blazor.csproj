<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <Version>0.0.0</Version>
    <!-- Required so the native libSkiaSharp (WebAssembly) binary is relinked into the app. -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="NetAF.Blazor" Version="10.0.1" />
    <!-- Provides the libSkiaSharp native binary compiled for browser-wasm. Version must match the transitive SkiaSharp version. -->
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the Skia native static library so WasmBuildNative includes it. -->
    <NativeFileReference Include="$(SkiaSharpStaticLibraryPath)\3.1.56\*.a" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SSHammerhead\SSHammerhead.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <Target Name="DeleteAudioResources" AfterTargets="Build" Condition="Exists('$(OutDir)Resources\Audio')">
    <ItemGroup>
      <AudioFilesToDelete Include="$(OutDir)Resources\Audio\**\*" />
    </ItemGroup>
    <Message Text="Deleting @(AudioFilesToDelete-&gt;Count()) audio file(s) from $(OutDir)Resources\Audio..." Importance="high" Condition="'@(AudioFilesToDelete)' != ''" />
    <Delete Files="@(AudioFilesToDelete)" />
  </Target>

</Project>
