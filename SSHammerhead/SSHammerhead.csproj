<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed all audio and image resources so they can be loaded via the assembly manifest.
         LogicalName keeps a stable, forward-slash key that matches the paths used in code. -->
    <EmbeddedResource Include="Resources\Audio\Effects\*.wav">
      <LogicalName>Resources/Audio/Effects/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Audio\Music\demos.mp3">
      <LogicalName>Resources/Audio/Music/demos.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Audio\Music\demons.mp3">
      <LogicalName>Resources/Audio/Music/demons.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\space.png">
      <LogicalName>Resources/Images/space.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\torii.png">
      <LogicalName>Resources/Images/torii.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.12" />
    <PackageReference Include="NetAF" Version="10.1.10" />
    <PackageReference Include="NetAF.Imaging" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
